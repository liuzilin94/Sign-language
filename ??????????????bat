@echo off
chcp 65001 >nul
title CSL手语识别系统 - 词汇验证
color 0A

echo ========================================
echo   CSL 手语识别系统 - 词汇验证模式
echo ========================================
echo.

REM 启动Flask后端服务
echo [1/3] 检查/启动后端服务...
cd /d E:\csl-recognition\recognition\backend
set FLASK_APP=app.py
set FLASK_ENV=development
start "后端服务 (127.0.0.1:5001)" cmd /k "python -m flask run --host=127.0.0.1 --port=5001"

REM 等待后端启动
echo 等待后端启动...
ping 127.0.0.1 -n 8 >nul 2>&1

REM 启动模型服务
echo.
echo [2/3] 启动模型检测服务...
cd /d E:\csl-recognition\recognition
start "模型服务" cmd /k "call run.bat"

REM 等待模型服务
echo 等待模型服务就绪...
ping 127.0.0.1 -n 10 >nul 2>&1

REM 启动HTTP服务器托管HTML页面
echo.
echo [3/3] 启动Web服务器...
cd /d E:\csl-recognition\recognition
start "Web服务器 (localhost:8080)" cmd /k "python -m http.server 8080"

echo.
echo ========================================
echo  启动完成！
echo ========================================
echo.
echo 请访问: http://localhost:8080/verify_word_frontend.html
echo.
echo 后端服务: http://127.0.0.1:5001
echo.
echo 按任意键打开浏览器...
pause >nul

start "" "http://localhost:8080/verify_word_frontend.html"

echo 完成！
pause
